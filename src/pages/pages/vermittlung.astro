---
import Site from '../../layouts/Site.astro';
import Photo from '../../components/site/Photo.astro';
import Icon from '../../components/ui/Icon.astro';
import { getImage } from 'astro:assets';
import { photo } from '../../data/photos';
import { contact, routes } from '../../data/site';
const poster = await getImage({
  src: photo('plakat-pflegestellen'),
  width: 1536,
  format: 'webp',
  quality: 82,
});
---

<Site
  title="Katzen suchen ein Zuhause"
  description="Die Katzen der Katzenfreunde Bietigheim-Bissingen, der Ablauf der Vermittlung, Schutzgebühren und Formulare."
  page="vermittlung"
  path="/pages/vermittlung.html"
>
  <div data-art class="page-head">
    <div class="wrap page-head__grid">
      <div>
        <h1>Katzen suchen ein Zuhause</h1>
        <p class="lead">
          Wir suchen für unsere Katzen ein sicheres, liebevolles Zuhause auf
          Lebenszeit.
        </p>
      </div>
      <aside class="panel person" aria-label="Ansprechpartnerin">
        <p class="person__role">Ihre Ansprechpartnerin für die Vermittlung</p>
        <p class="person__name">Iris Alberti</p>
        <a class="tel tel--l" href="tel:+4917631325306">
          <Icon name="phone" />
          <span class="num">01763 1325306</span>
        </a>
        <a
          class="mail"
          href="mailto:info@katzenfreunde-bietigheim-bissingen.de?subject=Katzenvermittlung"
        >
          <Icon name="envelope-simple" />
          <span class="mail__addr">{contact.mail}</span>
        </a>
      </aside>
    </div>
    <nav class="wrap toc" aria-label="Auf dieser Seite">
      <ul>
        <li>
          <a href="#katzen">Katzen</a>
        </li>
        <li>
          <a href="#ablauf">Ablauf</a>
        </li>
        <li>
          <a href="#gebuehren">Schutzgebühren</a>
        </li>
        <li>
          <a href="#formulare">Formulare</a>
        </li>
        <li>
          <a href="#pflegestelle">Pflegestelle werden</a>
        </li>
      </ul>
    </nav>
  </div>

  <section class="section section--tint" id="katzen" aria-labelledby="t-katzen">
    <div class="wrap">
      <div class="section__head">
        <h2 id="t-katzen">Diese zwei Katzen suchen ein Zuhause</h2>
      </div>
      <ul class="profiles">
        <li class="profile">
          <Photo
            name="katze-getigert"
            widths={[160, 480, 800, 1200]}
            sizes="(max-width: 63.99rem) 100vw, 600px"
            alt="Junge getigerte Katze auf einer blauen Decke in einer Transportbox"
            class="profile__photo"
            eager
            zoom
          />
          <div class="profile__body">
            <h3>Junge getigerte Katze</h3>
            <dl class="profile__facts">
              <div>
                <dt>Alter</dt>
                <dd>fünf Monate</dd>
              </div>
              <div>
                <dt>Wesen</dt>
                <dd>sehr zutraulich und verschmust</dd>
              </div>
              <div>
                <dt>Zuhause</dt>
                <dd>später mit Freigang</dd>
              </div>
              <div>
                <dt>Kastriert</dt>
                <dd>noch nicht</dd>
              </div>
            </dl>
            <a
              class="btn"
              href="mailto:info@katzenfreunde-bietigheim-bissingen.de?subject=Anfrage%20junge%20getigerte%20Katze"
            >
              <Icon name="envelope-simple" />
              Nach ihr fragen
            </a>
          </div>
        </li>
        <li class="profile">
          <div
            class="gallery profile__photo"
            data-gallery
            role="group"
            aria-label="Fotos von Franzi"
          >
            <div class="gallery__track" data-gallery-track>
              <div class="gallery__slide" data-slide="1">
                <Photo
                  name="franzi-portraet"
                  widths={[160, 480, 900]}
                  sizes="(max-width: 63.99rem) 100vw, 600px"
                  alt="Franzi, schwarze Katze mit gelben Augen, auf einem Katzenkissen"
                  zoom
                />
              </div>
              <div class="gallery__slide" data-slide="2">
                <Photo
                  name="franzi-liegend"
                  widths={[640, 1024, 1600]}
                  sizes="(max-width: 63.99rem) 100vw, 600px"
                  alt="Franzi liegt entspannt auf einer grauen Decke"
                  zoom
                />
              </div>
            </div>
            <button
              class="gallery__nav gallery__nav--prev"
              type="button"
              data-gallery-step="-1"
              aria-label="Vorheriges Foto"
            >
              <Icon name="caret-left" weight="bold" />
            </button>
            <button
              class="gallery__nav gallery__nav--next"
              type="button"
              data-gallery-step="1"
              aria-label="Nächstes Foto"
            >
              <Icon name="caret-right" weight="bold" />
            </button>
            <p class="gallery__count">
              <span data-gallery-n>1</span> von 2
            </p>
          </div>
          <div class="profile__body">
            <h3>Franzi</h3>
            <p class="profile__text">Franzi sucht ein liebevolles Zuhause.</p>
            <a
              class="btn"
              href="mailto:info@katzenfreunde-bietigheim-bissingen.de?subject=Anfrage%20Franzi"
            >
              <Icon name="envelope-simple" />
              Nach Franzi fragen
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section" id="ablauf" aria-labelledby="t-ablauf">
    <div class="wrap">
      <div class="flow__head">
        <h2 id="t-ablauf">So läuft die Vermittlung</h2>
        <p class="lead">
          Wir nehmen uns Zeit, damit Katze und Mensch zueinander passen.
        </p>
      </div>
      <ol class="flow flow--paws">
        <li>
          <span class="flow__n num" aria-hidden="true">
            1
          </span>
          <h3>Kontakt aufnehmen</h3>
          <p>
            Rufen Sie Iris Alberti an oder schreiben Sie uns eine E-Mail mit
            Ihrer Telefonnummer.
          </p>
        </li>
        <li>
          <span class="flow__n num" aria-hidden="true">
            2
          </span>
          <h3>Kontaktformular ausfüllen</h3>
          <p>
            Im{' '}
            <a href="/assets/media/data/Hoenig/Interessenten-Kontaktformular.pdf">
              Interessenten-Kontaktformular
            </a>{' '}
            beschreiben Sie Ihre Wünsche und wie die Katze bei Ihnen leben
            würde.
          </p>
        </li>
        <li>
          <span class="flow__n num" aria-hidden="true">
            3
          </span>
          <h3>Besuch vereinbaren</h3>
          <p>
            Im Formular können Sie Terminvorschläge eintragen. Wir melden uns
            bei Ihnen und vereinbaren einen Besuch.
          </p>
        </li>
        <li>
          <span class="flow__n num" aria-hidden="true">
            4
          </span>
          <h3>Einzug</h3>
          <p>
            Bei der Übergabe unterschreiben Sie die{' '}
            <a href="/assets/media/data/Abgabevereinbarung.pdf">
              Abgabevereinbarung
            </a>{' '}
            und zahlen die Schutzgebühr. Darin verpflichten Sie sich unter
            anderem, die Katze gut zu versorgen und sie bei Krankheit
            tierärztlich behandeln zu lassen. Falls noch nötig, lassen Sie sie
            kastrieren. Weitergeben dürfen Sie die Katze nicht.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" id="gebuehren" aria-labelledby="t-gebuehren">
    <div class="wrap two">
      <div>
        <h2 id="t-gebuehren">Schutzgebühren</h2>
        <p class="fee-fig num">100 bis 200&nbsp;€</p>
        <p>
          Die Höhe richtet sich nach Geschlecht und medizinischer Versorgung der
          Katze, nur in begründeten Ausnahmefällen kann sie höher sein.
        </p>
        <p class="muted">
          Die Schutzgebühr ist kein Kaufpreis, der Verein erzielt mit der
          Vermittlung keinen Gewinn.
        </p>
      </div>
      <div class="reasons">
        <div>
          <h3>Damit niemand vorschnell entscheidet</h3>
          <p>
            Eine Katze kostet über viele Jahre Zeit und Geld. Die Schutzgebühr
            soll vor übereilten Entscheidungen bewahren, damit keine Katze
            später im Tierheim landet oder ausgesetzt wird.
          </p>
        </div>
        <div>
          <h3>Damit die nächste Katze versorgt werden kann</h3>
          <p>
            Mit der Gebühr decken wir einen Teil der Kosten für Futter,
            Unterbringung und tierärztliche Versorgung, etwa für Impfungen,
            Entwurmungen und Kastrationen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="formulare" aria-labelledby="t-formulare">
    <div class="wrap">
      <div class="section__head section__head--stack">
        <h2 id="t-formulare">Formulare</h2>
        <p>
          Für Ihre Anfrage füllen Sie bitte das Interessenten-Kontaktformular
          aus. Die Abgabevereinbarung unterschreiben wir gemeinsam bei der
          Übergabe.
        </p>
      </div>
      <ul class="docs">
        <li>
          <a href="/assets/media/data/Hoenig/Interessenten-Kontaktformular.pdf">
            <Icon name="file-pdf" />
            <span>
              <b>Interessenten-Kontaktformular</b>
              <small>
                PDF, 111&nbsp;kB - wenn Sie eine Katze aufnehmen möchten
              </small>
            </span>
          </a>
        </li>
        <li>
          <a href="/assets/media/data/Abgabevereinbarung.pdf">
            <Icon name="file-pdf" />
            <span>
              <b>Abgabevereinbarung</b>
              <small>
                PDF, 97&nbsp;kB - der Vertrag, den Sie bei der Übergabe der
                Katze unterschreiben
              </small>
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section
    class="section section--tint"
    id="pflegestelle"
    aria-labelledby="t-pflege-a"
  >
    <div class="wrap foster">
      <div>
        <h2 id="t-pflege-a">Pflegestelle werden</h2>
        <p class="lead">
          Wir suchen dringend Pflegestellen in Bietigheim-Bissingen und
          Umgebung. Bei Ihnen lebt eine Katze so lange, bis wir ein dauerhaftes
          Zuhause für sie gefunden haben.
        </p>
        <ul class="ticks">
          <li>
            <Icon name="house-line" />
            <span>
              Sie stellen der Katze ein eigenes Zimmer zur Verfügung und kümmern
              sich mit Zeit und Geduld um sie.
            </span>
          </li>
          <li>
            <Icon name="stethoscope" />
            <span>
              Futter, Tierarztkosten und alles Weitere bezahlt der Verein.
            </span>
          </li>
        </ul>
        <div class="btn-row">
          <a class="btn" href="tel:+4917631325306">
            <Icon name="phone" />
            Iris Alberti anrufen
          </a>
          <a
            class="btn btn--soft"
            href="mailto:info@katzenfreunde-bietigheim-bissingen.de?subject=Pflegestelle"
          >
            <Icon name="envelope-simple" />
            <span class="mail__addr">{contact.mail}</span>
          </a>
        </div>
      </div>
      <figure class="pinned pinned--flat">
        <a
          href={poster.src}
          data-zoom="Plakat: Wir suchen dringend Pflegestellen für unsere Katzen"
        >
          <Photo
            name="plakat-pflegestellen"
            widths={[800]}
            sizes="(max-width: 47.99rem) 100vw, 40vw"
            alt="Plakat: Wir suchen dringend Pflegestellen für unsere Katzen"
          />
        </a>
        <figcaption>Das Plakat zum Ausdrucken und Weitergeben.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--slim" aria-labelledby="t-daheim">
    <div class="wrap endline">
      <h2 id="t-daheim" class="h-small">
        Endlich daheim
      </h2>
      <p>
        Ehemalige Schützlinge schicken uns Fotos und Geschichten aus ihrem neuen
        Zuhause.
      </p>
      <a class="go" href={routes.daheim}>
        <span>Geschichten lesen</span>
        <Icon name="arrow-right" />
      </a>
    </div>
  </section>
</Site>
