---
import Site from '../../layouts/Site.astro';
import Photo from '../../components/site/Photo.astro';
import Icon from '../../components/ui/Icon.astro';
import girocode from '../../assets/girocode-frei.svg';
import {
  bank,
  contact,
  external,
  ibanGroups,
  membershipRates,
  routes,
} from '../../data/site';
---

<Site
  title="Helfen"
  description="Spenden, Mitgliedschaft, Pflegestelle oder Sachspenden: So unterstützen Sie die Katzenfreunde Bietigheim-Bissingen."
  page="helfen"
  path="/pages/spenden.html"
>
  <div class="page-head wrap help">
    <div>
      <h1>So können Sie helfen</h1>
      <p class="lead">
        Wir erhalten keine Zuschüsse aus öffentlicher Hand. Deshalb sind wir auf
        Spenden, Mitgliedsbeiträge und die Erlöse unseres Flohmarkts angewiesen.
      </p>
    </div>
    <ul class="ways">
      <li>
        <a href="#spenden">
          <Icon name="hand-coins" />
          <span>
            <b>Geld spenden</b> per Überweisung, GiroCode oder PayPal
          </span>
        </a>
      </li>
      <li>
        <a href="#mitglied">
          <Icon name="users-three" />
          <span>
            <b>Mitglied werden</b> und den Verein mit einem Jahresbeitrag
            unterstützen
          </span>
        </a>
      </li>
      <li>
        <a href="#pflege">
          <Icon name="house-line" />
          <span>
            <b>Pflegestelle werden</b> und eine Katze auf Zeit aufnehmen
          </span>
        </a>
      </li>
      <li>
        <a href="#sachspenden">
          <Icon name="package" />
          <span>
            <b>Sachspenden für den Flohmarkt</b> für unseren Flohmarktstand
          </span>
        </a>
      </li>
    </ul>
  </div>
  <section
    class="section section--tint"
    id="spenden"
    aria-labelledby="t-spenden"
  >
    <div class="wrap">
      <h2 id="t-spenden">Geld spenden</h2>
      <div class="give" data-give>
        <section class="slip" aria-label="Überweisung">
          <p class="slip__head">
            <Icon name="bank" />
            Überweisung
            <button
              class="tip__btn tip__btn--head"
              type="button"
              popovertarget="betrag-info"
              aria-label="Wofür wir Ihre Spende einsetzen"
            >
              <Icon name="info" />
              Wofür?
            </button>
          </p>
          <div class="slip__grid">
            <dl class="slip__fields">
              <div class="slip__f slip__f--wide">
                <dt>Empfänger</dt>
                <dd>
                  {bank.name.replace(' V.', '\u00A0V.')}
                  <button
                    class="util util--sm copy"
                    type="button"
                    data-copy={bank.name}
                    data-what="Empfänger"
                  >
                    <Icon name="copy" class="i copy__copy" />
                    <Icon name="check" class="i copy__done" />
                    <span class="sr-only" data-copy-label>
                      Empfänger kopieren
                    </span>
                  </button>
                </dd>
              </div>
              <div class="slip__f slip__f--wide">
                <dt>IBAN</dt>
                <dd>
                  <span class="slip__iban num">{ibanGroups(bank.iban)}</span>
                  <button
                    class="util util--sm copy"
                    type="button"
                    data-copy={bank.iban}
                    data-what="IBAN"
                  >
                    <Icon name="copy" class="i copy__copy" />
                    <Icon name="check" class="i copy__done" />
                    <span class="sr-only" data-copy-label>
                      IBAN kopieren
                    </span>
                  </button>
                </dd>
              </div>
              <div class="slip__f">
                <dt>BIC</dt>
                <dd class="num">
                  {bank.bic}
                  <button
                    class="util util--sm copy"
                    type="button"
                    data-copy={bank.bic}
                    data-what="BIC"
                  >
                    <Icon name="copy" class="i copy__copy" />
                    <Icon name="check" class="i copy__done" />
                    <span class="sr-only" data-copy-label>
                      BIC kopieren
                    </span>
                  </button>
                </dd>
              </div>
              <div class="slip__f slip__f--amount">
                <dt>
                  <label for="betrag-eingabe">Betrag</label>
                  <button
                    class="tip__btn"
                    type="button"
                    popovertarget="betrag-info"
                    aria-label="Wofür wir Ihre Spende einsetzen"
                  >
                    <Icon name="info" />
                  </button>
                </dt>
                <dd>
                  <span class="slip__amount">
                    <input
                      id="betrag-eingabe"
                      class="num"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      placeholder="Betrag eingeben"
                      aria-describedby="betrag-hinweis"
                    />
                    <span aria-hidden="true">€</span>
                  </span>
                  <p
                    class="slip__error"
                    id="betrag-fehler"
                    data-amount-error
                    hidden
                  >
                    <Icon name="warning-circle" />
                    Bitte geben Sie einen Betrag in Euro ein, zum Beispiel 25.
                  </p>
                </dd>
              </div>
              <div class="slip__f slip__f--wide">
                <dt>Verwendungszweck</dt>
                <dd class="slip__purpose">Spende und Ihre Anschrift</dd>
              </div>
            </dl>
            <div class="qr">
              <div class="qr__code" data-qr>
                <img
                  src={girocode.src}
                  width="140"
                  height="140"
                  alt="GiroCode mit der Bankverbindung, ohne Betrag"
                />
              </div>
              <p id="betrag-hinweis">
                Scannen Sie den Code mit Ihrer Banking-App. Ein eingetragener
                Betrag ist darin schon enthalten. Ihre Anschrift ergänzen Sie
                bitte im Verwendungszweck.
              </p>
            </div>
          </div>
        </section>
        <div id="betrag-info" class="tip glass" popover>
          <p class="tip__t">Wofür wir Ihre Spende einsetzen</p>
          <dl>
            <div data-tier="12">
              <dt class="num">ab 12&nbsp;€</dt>
              <dd>
                Untersuchung und Impfungen gegen Katzenschnupfen und
                Katzenseuche
              </dd>
            </div>
            <div data-tier="20">
              <dt class="num">ab 20&nbsp;€</dt>
              <dd>Narkose und Schmerzmittel</dd>
            </div>
            <div data-tier="50">
              <dt class="num">ab 50&nbsp;€</dt>
              <dd>Kastration einer Kätzin</dd>
            </div>
            <div data-tier="120">
              <dt class="num">ab 120&nbsp;€</dt>
              <dd>Operative Eingriffe und Strahlenbehandlungen</dd>
            </div>
          </dl>
          <p class="tip__note">
            Die Beträge sind Beispiele aus unserer Arbeit.
          </p>
        </div>
        <div class="give__alt">
          <p>
            Sie können auch mit <Icon name="si-paypal" class="i paypal" />
            <a href={external.paypal}>PayPal spenden</a>. Für eine regelmäßige
            Unterstützung schicken Sie uns das{' '}
            <a href="/assets/media/data/Spendenformular.pdf">
              Formular für eine Dauerspende
            </a>{' '}
            (PDF, 89&nbsp;kB) ausgefüllt zurück.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-label="Wohin Ihre Spende geht">
    <div class="wrap">
      <h2 id="t-wohin">Wohin Ihre Spende geht</h2>
      <div class="figs">
        <div>
          <p class="figs__n num">100&nbsp;%</p>
          <p>Ihrer Spende kommen den Katzen zugute.</p>
        </div>
        <div>
          <p class="figs__n num">&gt;&nbsp;75&nbsp;%</p>
          <p>unserer Ausgaben sind Tierarztkosten.</p>
        </div>
        <div>
          <p class="figs__n num">3&nbsp;%</p>
          <p>
            fallen für Verwaltung und Öffentlichkeitsarbeit an. Diese Kosten
            decken wir überwiegend aus den Erlösen unseres Flohmarkts.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="section section--quiet" aria-label="Weitere Möglichkeiten">
    <div class="wrap duo">
      <section id="mitglied" aria-labelledby="t-mitglied">
        <h2 id="t-mitglied">Mitglied werden</h2>
        <p>
          Als Mitglied unterstützen Sie die Arbeit des Vereins dauerhaft. Sie
          müssen dafür nicht aktiv mitarbeiten.
        </p>
        <p>
          Laden Sie den Aufnahmeantrag herunter und schicken Sie ihn ausgefüllt
          an unsere Geschäftsstelle. Für die Lastschrift enthält er bereits das
          SEPA-Lastschriftmandat. Nach dem Beschluss des Vorstands erhalten Sie
          eine Bestätigung.
        </p>
        <p>
          {membershipRates} Mitgliedsbeiträge und Spenden sind steuerlich
          absetzbar.
        </p>
        <ul class="docs">
          <li>
            <a href="/assets/media/data/Aufnahmeantrag.pdf">
              <Icon name="file-pdf" />
              <span>
                <b>Aufnahmeantrag</b>
                <small>PDF, 91&nbsp;kB</small>
              </span>
            </a>
          </li>
          <li>
            <a href="/assets/media/data/Hoenig/SEPA.pdf">
              <Icon name="file-pdf" />
              <span>
                <b>Informationen zur SEPA-Umstellung</b>
                <small>PDF, 61&nbsp;kB</small>
              </span>
            </a>
          </li>
        </ul>
      </section>
      <section id="pflege" aria-labelledby="t-pflege">
        <h2 id="t-pflege">Pflegestelle werden</h2>
        <p>
          Katzen, die auf ein Zuhause warten, leben bei uns in Pflegestellen.
          Der Verein stellt das Futter und übernimmt die Tierarztkosten. Sie
          bieten der Katze Platz und schenken ihr Zeit und Zuwendung.
        </p>
        <Photo
          name="plakat-pflegestellen"
          widths={[480, 800]}
          sizes="(max-width: 47.99rem) 60vw, 14rem"
          alt="Plakat: Wir suchen dringend Pflegestellen für unsere Katzen"
          class="duo__poster"
          zoom
        />
        <a class="go" href={`${routes.vermittlung}#pflegestelle`}>
          <span>Voraussetzungen für eine Pflegestelle</span>
          <Icon name="arrow-right" />
        </a>
      </section>
    </div>
  </section>
  <section
    class="section section--quiet"
    id="sachspenden"
    aria-labelledby="t-sachen"
  >
    <div class="wrap">
      <h2 id="t-sachen">Sachspenden für den Flohmarkt</h2>
      <div class="duo">
        <div>
          <h3 class="h-small">Für den Flohmarkt</h3>
          <p>
            Gut erhaltene Gegenstände und Waren aus Nachlässen verkaufen wir an
            unserem Flohmarktstand. Der Erlös fließt in die Versorgung der
            Katzen. Bitte rufen Sie vorher Jutta oder Volkmar Framenau unter{' '}
            <a class="num" href={contact.tel}>
              {contact.phone}
            </a>{' '}
            an.
          </p>
        </div>
        <div>
          <h3 class="h-small">Über den Futter-Shuttle</h3>
          <p>
            Wenn Sie Ihr Tierfutter über unseren Link beim Futter-Shuttle
            bestellen, unterstützen Sie damit den Verein.
          </p>
          <a class="go" href={external.futterShuttle} referrerpolicy="origin">
            <span>Zum Futter-Shuttle</span>
            <Icon name="arrow-up-right" />
          </a>
        </div>
      </div>
      <p class="asknote">
        Fragen zu Spenden oder Beiträgen beantwortet Marlis Kälber, die sich um
        die Finanzen des Vereins kümmert:{' '}
        <a class="mail" href={contact.mailHref}>
          {contact.mail}
        </a>
      </p>
    </div>
  </section>
</Site>

<script>
  import { initGive } from '../../scripts/give';
  initGive();
</script>
