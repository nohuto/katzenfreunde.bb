---
import CopyList from '../../components/ui/CopyList.astro';
import KatzenfreundeLayout from '../../layouts/KatzenfreundeLayout.astro';

const quick = [
  {
    label: 'Telefon',
    value: '07042 34355',
    copy: '0704234355',
    href: 'tel:+49704234355',
    mono: true,
  },
  {
    label: 'Zentrale E-Mail',
    value: 'info@katzenfreunde-bietigheim-bissingen.de',
    href: 'mailto:info@katzenfreunde-bietigheim-bissingen.de',
  },
  {
    label: 'WhatsApp',
    value: '01577 2702827',
    copy: '015772702827',
    href: 'https://wa.me/4915772702827',
    external: true,
    mono: true,
  },
  { label: 'Adresse', value: 'Im Vogelsang 11, 74372 Sersheim' },
];

interface Way {
  icon: 'mail' | 'phone' | 'printer';
  label: string;
  value: string;
  copy: string;
  href?: string;
}

const info: Way = {
  icon: 'mail',
  label: 'E-Mail',
  value: 'info@katzenfreunde-bietigheim-bissingen.de',
  copy: 'info@katzenfreunde-bietigheim-bissingen.de',
  href: 'mailto:info@katzenfreunde-bietigheim-bissingen.de',
};

const people: { name: string; roles: string[]; ways: Way[] }[] = [
  {
    name: 'Jutta Framenau',
    roles: ['Vorsitzende'],
    ways: [
      info,
      {
        icon: 'phone',
        label: 'Telefon',
        value: '07042 34355',
        copy: '0704234355',
        href: 'tel:+49704234355',
      },
      {
        icon: 'printer',
        label: 'Fax',
        value: '07042 816627',
        copy: '07042816627',
      },
    ],
  },
  {
    name: 'Iris Alberti',
    roles: ['Stellvertretende', 'Katzenvermittlung'],
    ways: [
      {
        icon: 'phone',
        label: 'Telefon',
        value: '01763 1325306',
        copy: '017631325306',
        href: 'tel:+4917631325306',
      },
    ],
  },
  { name: 'Marlis Kälber', roles: ['Finanzen'], ways: [info] },
  {
    name: 'Anni Kallert',
    roles: ['Schriftführerin', 'Soziale Medien'],
    ways: [info],
  },
  {
    name: 'N. B.',
    roles: ['Webmaster'],
    ways: [
      {
        icon: 'mail',
        label: 'E-Mail',
        value: 'katzenfreunde@noverse.dev',
        copy: 'katzenfreunde@noverse.dev',
        href: 'mailto:katzenfreunde@noverse.dev',
      },
    ],
  },
];

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('');
---

<KatzenfreundeLayout
  title="Kontakt - Katzenfreunde BiBi"
  description="Persönliche Ansprechpartner:innen und schnelle Kontaktwege."
  page="kontakt"
  canonical="/pages/kontakt.html"
>
  <main>
    <section class="hero">
      <div class="hero__card hero__card--title-only">
        <div>
          <h1>Kontakt</h1>
        </div>
      </div>
    </section>
    <div class="page-shell">
      <article class="rich-content prose page-content">
        <section>
          <p>
            Hier finden Sie alle direkten Kontaktwege und Ansprechpartner:innen.
            Bitte geben Sie bei E-Mail-Anfragen nach M&ouml;glichkeit eine
            Telefonnummer an, damit wir Sie bei R&uuml;ckfragen schnell
            erreichen k&ouml;nnen.
          </p>
          <CopyList
            groups={[{ title: 'Schnellkontakt', icon: 'phone', items: quick }]}
            split
          />
        </section>
        <section aria-labelledby="ansprechpartner" class="section-divider">
          <h2 id="ansprechpartner">Ansprechpartner:innen</h2>
          <div class="person-grid">
            {people.map((person) => (
              <article class="person-card">
                <div class="person-card__top">
                  <span aria-hidden="true" class="person-card__initials">
                    {initials(person.name)}
                  </span>
                  <div>
                    <p class="person-card__name">{person.name}</p>
                    <p class="person-card__roles">{person.roles.join(' · ')}</p>
                  </div>
                </div>
                <ul class="person-card__ways">
                  {person.ways.map((way) => (
                    <li>
                      <span class="person-card__icon" data-icon={way.icon} />
                      {way.href ? (
                        <a href={way.href}>{way.value}</a>
                      ) : (
                        <span>{way.value}</span>
                      )}
                      <button
                        aria-label={`${way.label} kopieren`}
                        class="copy-button"
                        data-copy-text={way.copy}
                        type="button"
                      />
                    </li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
      </article>
    </div>
  </main>
</KatzenfreundeLayout>
