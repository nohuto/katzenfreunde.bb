---
import Site from '../../layouts/Site.astro';
import Icon from '../../components/ui/Icon.astro';
import { contact, routes } from '../../data/site';
---

<Site
  title="Kontakt"
  description="Telefon, WhatsApp, E-Mail und Ansprechpartner der Katzenfreunde Bietigheim-Bissingen."
  page="kontakt"
  path="/pages/kontakt.html"
>
  <div class="page-head wrap">
    <h1>Kontakt</h1>
    <p class="lead">Sie erreichen uns per Telefon, WhatsApp oder E-Mail.</p>
    <div class="reach">
      <div>
        <p class="reach__label">Telefon</p>
        <a class="tel tel--hero" href={contact.tel}>
          <Icon name="phone" />
          <span class="num">{contact.phone}</span>
        </a>
      </div>
      <div class="reach__more">
        <div>
          <p class="reach__label">WhatsApp</p>
          <a class="num reach__val" href={contact.whatsappHref}>
            {contact.whatsapp}
          </a>
        </div>
        <div>
          <p class="reach__label">E-Mail</p>
          <a class="mail reach__val" href={contact.mailHref}>
            {contact.mail}
          </a>
        </div>
      </div>
    </div>
  </div>
  <section class="section section--tint" aria-labelledby="t-people">
    <div class="wrap">
      <h2 id="t-people">Ansprechpartnerinnen und Ansprechpartner</h2>
      <ul class="badges">
        <li class="badge">
          <h3 class="badge__name">Jutta Framenau</h3>
          <p class="badge__role">Vorsitzende</p>
          <div class="badge__ways">
            <a class="num" href={contact.tel}>
              <Icon name="phone" />
              {contact.phone}
            </a>
            <a class="mail" href={contact.mailHref}>
              <Icon name="envelope-simple" />
              <span class="mail__addr">{contact.mail}</span>
            </a>
            <span class="num">
              <Icon name="printer" />
              Fax {contact.fax}
            </span>
          </div>
        </li>
        <li class="badge">
          <h3 class="badge__name">Iris Alberti</h3>
          <p class="badge__role">
            Stellvertretende Vorsitzende, Katzenvermittlung
          </p>
          <div class="badge__ways">
            <a class="num" href="tel:+4917631325306">
              <Icon name="phone" />
              01763 1325306
            </a>
          </div>
        </li>
        <li class="badge">
          <h3 class="badge__name">Marlis Kälber</h3>
          <p class="badge__role">Finanzen</p>
          <div class="badge__ways">
            <a class="mail" href={contact.mailHref}>
              <Icon name="envelope-simple" />
              <span class="mail__addr">{contact.mail}</span>
            </a>
          </div>
        </li>
        <li class="badge">
          <h3 class="badge__name">Anni Kallert</h3>
          <p class="badge__role">Schriftführerin, soziale Medien</p>
          <div class="badge__ways">
            <a class="mail" href={contact.mailHref}>
              <Icon name="envelope-simple" />
              <span class="mail__addr">{contact.mail}</span>
            </a>
          </div>
        </li>
        <li class="badge">
          <h3 class="badge__name">N.&nbsp;B.</h3>
          <p class="badge__role">Webentwicklung</p>
          <div class="badge__ways">
            <a class="mail" href="mailto:katzenfreunde@noverse.dev">
              <Icon name="envelope-simple" />
              <span class="mail__addr">katzenfreunde@noverse.dev</span>
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>
  <section class="section" aria-labelledby="t-post">
    <div class="wrap duo">
      <div>
        <h2 id="t-post" class="h-small">
          Geschäftsstelle
        </h2>
        <address class="addr">
          Katzenfreunde Bietigheim-Bissingen e.&nbsp;V.
          <br />
          {contact.street}
          <br />
          {contact.city}
        </address>
        <a class="go" href={contact.map}>
          <span>Auf der Karte zeigen</span>
          <Icon name="arrow-right" />
        </a>
      </div>
      <div>
        <h2 class="h-small">Sie möchten uns besuchen?</h2>
        <p>
          Unsere Katzen leben in Pflegestellen. Wenn Sie eine Katze kennenlernen
          möchten, vereinbaren Sie bitte einen Termin mit Iris Alberti.
        </p>
        <a class="go" href={routes.vermittlung}>
          <span>Katzen, die ein Zuhause suchen</span>
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</Site>
