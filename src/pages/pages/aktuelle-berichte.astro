---
import Site from '../../layouts/Site.astro';
import Photo from '../../components/site/Photo.astro';
import Icon from '../../components/ui/Icon.astro';
import { external } from '../../data/site';
import { events } from '../../data/events';
---

<Site
  title="Aktuelles"
  description="Termine und Berichte der Katzenfreunde Bietigheim-Bissingen."
  page="aktuelles"
  path="/pages/aktuelle-berichte.html"
>
  <div class="page-head wrap">
    <h1>Aktuelles</h1>
    <p class="lead">
      Unsere nächsten Termine und Berichte aus der Vereinsarbeit.
    </p>
  </div>
  <div class="wrap feed" data-count>
    <fieldset class="chips">
      <legend class="sr-only">Anzeigen</legend>
      <label class="chip">
        <input type="radio" name="filter" value="alle" checked />
        <span>
          Alles <span class="chip__n num" data-n="alle"></span>
        </span>
      </label>
      <label class="chip">
        <input type="radio" name="filter" value="termin" />
        <span>
          Termine <span class="chip__n num" data-n="termin"></span>
        </span>
      </label>
      <label class="chip">
        <input type="radio" name="filter" value="bericht" />
        <span>
          Berichte <span class="chip__n num" data-n="bericht"></span>
        </span>
      </label>
      <label class="chip">
        <input type="radio" name="filter" value="verein" />
        <span>
          Verein <span class="chip__n num" data-n="verein"></span>
        </span>
      </label>
    </fieldset>
    <ol class="list" data-dates>
      {events.map((event) => (
        <li
          class="list__row is-termin"
          data-kind="termin"
          data-until={event.date}
        >
          <div class="list__date">
            <time datetime={event.date}>
              <span class="list__d num">
                {event.day}.&nbsp;{event.month}
              </span>
              <span class="list__y num">{event.year}</span>
            </time>
            <span class="list__type">Termin</span>
          </div>
          <div class="list__main">
            <h2 class="list__t">{event.title}</h2>
            <p>
              Von {event.from} bis {event.to}&nbsp;Uhr {event.placeInline}.
            </p>
          </div>
        </li>
      ))}
      <li class="list__row" data-kind="bericht" id="b-2026-05-05">
        <div class="list__date">
          <time datetime="2026-05-05">
            <span class="list__d num">5.&nbsp;Mai</span>
            <span class="list__y num">2026</span>
          </time>
          <span class="list__type">Bericht</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Wurst- und Getränkestopp mit Flohmarkt</h2>
          <p>
            Vielen Dank an alle Gäste und Helfer. Der gesamte Erlös kommt den
            Katzen zugute.
          </p>
        </div>
        <Photo
          name="plakat-danke-mai2026"
          widths={[256]}
          sizes="8rem"
          class="list__img"
        />
      </li>
      <li class="list__row" data-kind="verein" id="b-2026-04-03">
        <div class="list__date">
          <time datetime="2026-04-03">
            <span class="list__d num">3.&nbsp;April</span>
            <span class="list__y num">2026</span>
          </time>
          <span class="list__type">Hinweis</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Folgen Sie uns auf Instagram</h2>
          <p>Aktuelle Neuigkeiten finden Sie auch auf Instagram.</p>
          <p>
            <a class="go" href={external.instagram}>
              <span>instagram.com/katzenfreunde_bietigheim</span>
              <Icon name="arrow-up-right" />
            </a>
          </p>
        </div>
      </li>
      <li class="list__row" data-kind="bericht" id="b-2021-07-08">
        <div class="list__date">
          <time datetime="2021-07-08">
            <span class="list__d num">8.&nbsp;Juli</span>
            <span class="list__y num">2021</span>
          </time>
          <span class="list__type">Bericht</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">
            Die Katzenfreunde gewinnen bei „Schwimm für deinen Verein“
          </h2>
          <p>
            Zum 40-jährigen Jubiläum des Badeparks Ellental haben die Stadtwerke
            Bietigheim-Bissingen Spenden für Vereine gesammelt. Die
            Katzenfreunde schwammen die meisten Bahnen und erhielten 400&nbsp;€.
          </p>
          <p>
            <a class="go" href="/assets/media/data/Bericht_Spende400.pdf">
              <span>Bericht über die Spende (PDF, 5,2&nbsp;MB)</span>
              <Icon name="download-simple" />
            </a>
          </p>
        </div>
        <Photo
          name="bericht-spende400"
          widths={[256]}
          sizes="8rem"
          class="list__img"
        />
      </li>
      <li class="list__row" data-kind="bericht" id="b-2020-05-02">
        <div class="list__date">
          <time datetime="2020-05-02">
            <span class="list__d num">2.&nbsp;Mai</span>
            <span class="list__y num">2020</span>
          </time>
          <span class="list__type">Bericht</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Grüße von den kleinen „Piroschkas“</h2>
          <p>
            Vor zwei Wochen haben wir zwei Katzenkinder übernommen. Beide haben
            gut zugenommen und entwickeln sich prächtig.
          </p>
        </div>
        <Photo
          name="bericht-piroschkas"
          widths={[256]}
          sizes="8rem"
          class="list__img"
        />
      </li>
      <li class="list__row" data-kind="bericht" id="b-2020-04-21">
        <div class="list__date">
          <time datetime="2020-04-21">
            <span class="list__d num">21.&nbsp;April</span>
            <span class="list__y num">2020</span>
          </time>
          <span class="list__type">Bericht</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Zwei Katzenbabys aus Ungarn gerettet</h2>
          <p>
            Die Firma Magna in Bietigheim-Bissingen rief uns an: In einem Paket
            aus Ungarn waren im Wareneingang zwei kleine Katzenbabys angekommen.
            Ein Mitarbeiter hat sich herzlich für unsere schnelle Hilfe bedankt
            und sich nach den beiden erkundigt. Wir danken ihm für seinen
            Einsatz. Die beiden Katzenkinder sind wohlauf und entwickeln sich
            sehr gut.
          </p>
        </div>
        <div class="list__imgs">
          <Photo
            name="bericht-katzenbaby-1"
            widths={[300]}
            sizes="8rem"
            class="list__img"
          />
          <Photo
            name="bericht-katzenbaby-2"
            widths={[300]}
            sizes="8rem"
            class="list__img"
          />
        </div>
      </li>
      <li class="list__row" data-kind="verein">
        <div class="list__date">
          <span class="list__type">Auszeichnung</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Ehrennadel für Jutta Framenau</h2>
          <p>
            Für ihren langjährigen Einsatz für streunende und hilfsbedürftige
            Katzen hat Jutta Framenau die Landesehrennadel erhalten.
          </p>
        </div>
      </li>
      <li class="list__row" data-kind="verein" id="b-2017-10-04">
        <div class="list__date">
          <time datetime="2017-10-04">
            <span class="list__d num">4.&nbsp;Oktober</span>
            <span class="list__y num">2017</span>
          </time>
          <span class="list__type">Hinweis</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Wir sind auch auf Facebook</h2>
          <p>Besuchen Sie gern unsere Facebook-Seite.</p>
          <p>
            <a class="go" href={external.facebook}>
              <span>facebook.com/katzenfreundebibi</span>
              <Icon name="arrow-up-right" />
            </a>
          </p>
        </div>
      </li>
      <li class="list__row" data-kind="verein" id="b-2016-03-30">
        <div class="list__date">
          <time datetime="2016-03-30">
            <span class="list__d num">30.&nbsp;März</span>
            <span class="list__y num">2016</span>
          </time>
          <span class="list__type">Verein</span>
        </div>
        <div class="list__main">
          <h2 class="list__t">Mitglied im Deutschen Tierschutzbund</h2>
          <p>
            Der Deutsche Tierschutzbund hat unseren Aufnahmeantrag bestätigt.
            Wir freuen uns über den Kontakt mit anderen Tierschutzvereinen.
          </p>
          <p>
            <a class="go" href="https://www.tierschutzbund.de/">
              <span>tierschutzbund.de</span>
              <Icon name="arrow-up-right" />
            </a>
          </p>
        </div>
      </li>
      <li class="dates__empty" hidden data-dates-empty>
        Zurzeit stehen keine Termine fest.
      </li>
    </ol>
    <section class="flyer" aria-labelledby="t-flyer">
      <h2 id="t-flyer" class="h-small">
        Unser Flyer zum Auslegen
      </h2>
      <p>
        Wir freuen uns, wenn Sie unseren Flyer in Praxen und Geschäften oder an
        anderen öffentlichen Orten auslegen.
      </p>
      <ul class="docs">
        <li>
          <a href="/assets/media/data/Flyer_Vorderseite.pdf">
            <Icon name="file-pdf" />
            <span>
              <b>Flyer, Vorderseite</b>
              <small>PDF, 2,3&nbsp;MB</small>
            </span>
          </a>
        </li>
        <li>
          <a href="/assets/media/data/Flyer_Rueckseite.pdf">
            <Icon name="file-pdf" />
            <span>
              <b>Flyer, Rückseite</b>
              <small>PDF, 1,9&nbsp;MB</small>
            </span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</Site>
