---
import Img from '../../components/ui/Img.astro';
import KatzenfreundeLayout from '../../layouts/KatzenfreundeLayout.astro';
---

<KatzenfreundeLayout
  title="Tierärztliche Versorgung - Katzenfreunde BiBi"
  description="Behandlung, Pflege und medizinische Unterstützung für Tiere in Not."
  page="tieraerztl-versorgung"
  canonical="/pages/tieraerztl-versorgung.html"
>
  <main class="page-shell">
    <article class="rich-content prose page-content">
      <section class="activity-header">
        <h1>Tier&auml;rztliche Versorgung</h1>
        <p>
          Behandlung, Pflege und medizinische Unterst&uuml;tzung f&uuml;r Tiere
          in Not.
        </p>
      </section>
      <div class="content-prose">
        <p>
          F&uuml;r uns gibt es bisher keine finanzielle Unterst&uuml;tzung durch
          die Kommunen. Derzeit entfallen mehr als 75% unserer gesamten
          Aufwendungen auf Tierarztkosten. Konsequent lassen wir die Katzen
          kastrieren und tier&auml;rztlich intensiv versorgen.{' '}
          <strong>Wir gehen mit jeder Katze zum Tierarzt.</strong> Falls Sie
          zweckgebunden spenden m&ouml;chten, w&auml;re die anteilige
          &Uuml;bernahme von Tierarztkosten - in H&ouml;he der von Ihnen frei
          gew&auml;hlten Spende - eine wunderbare M&ouml;glichkeit, unseren
          kranken Katzen Gutes zu tun. Die Folgen sind ges&uuml;ndere Tiere und
          weniger F&auml;lle ausgesetzter, streunender Katzen, also weniger
          Katzenelend. Operationen, Kastrationen und Wundversorgung k&ouml;nnen
          wir mit dem uns bisher zur Verf&uuml;gung stehenden Spendenaufkommen
          und aus Mitgliedsbeitr&auml;gen nicht allein bew&auml;ltigen.
        </p>
        <p>
          <strong>
            Die Bildrechte an folgenden Fotos liegen bei der Tierarztpraxis
            Hoffmann-Fuesser, Bietigheim-Bissingen.
          </strong>
        </p>
        <p>Wir danken f&uuml;r die freundliche &Uuml;berlassung der Bilder.</p>
        <div
          aria-label="Bilder tier&auml;rztlicher Versorgung"
          class="vet-gallery"
        >
          <figure class="vet-gallery__item">
            <picture>
              <Img
                alt="Projektil in der Haut einer Katze"
                fetchpriority="high"
                loading="eager"
                src="/assets/media/resources/tieraerztliche-versorgung-projektil.jpg"
              />
            </picture>
            <figcaption>Projektil in Haut einer Katze</figcaption>
          </figure>
          <figure class="vet-gallery__item">
            <picture>
              <Img
                alt="Katzenschnupfen"
                loading="lazy"
                src="/assets/media/resources/tieraerztliche-versorgung-katzenschnupfen.jpg"
              />
            </picture>
            <figcaption>Katzenschnupfen</figcaption>
          </figure>
          <figure class="vet-gallery__item">
            <picture>
              <Img
                alt="Katzenschur"
                loading="lazy"
                src="/assets/media/resources/tieraerztliche-versorgung-katzenschur.jpg"
              />
            </picture>
            <figcaption>Katzenschur</figcaption>
          </figure>
          <figure class="vet-gallery__item">
            <picture>
              <Img
                alt="Schoppenkatze"
                loading="lazy"
                src="/assets/media/resources/ehrung-jutta-framenau-1.jpg"
              />
            </picture>
            <figcaption>Schoppenkatze</figcaption>
          </figure>
          <figure class="vet-gallery__item">
            <picture>
              <Img
                alt="Kater nach Ohramputation wegen Tumor"
                loading="lazy"
                src="/assets/media/resources/tieraerztliche-versorgung-ohramputation.jpg"
              />
            </picture>
            <figcaption>Kater nach Ohramputation wegen Tumor</figcaption>
          </figure>
          <figure class="vet-gallery__item">
            <picture>
              <Img
                alt="Würmer"
                loading="lazy"
                src="/assets/media/resources/tieraerztliche-versorgung-wuermer.jpg"
              />
            </picture>
            <figcaption>W&uuml;rmer</figcaption>
          </figure>
        </div>
      </div>
    </article>
  </main>
</KatzenfreundeLayout>
