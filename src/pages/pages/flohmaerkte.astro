---
import Img from '../../components/ui/Img.astro';
import KatzenfreundeLayout from '../../layouts/KatzenfreundeLayout.astro';
---

<KatzenfreundeLayout
  title="Flohmarkt - Katzenfreunde BiBi"
  description="Flohmarktaktionen zur Finanzierung der Tierschutzarbeit."
  page="flohmaerkte"
  canonical="/pages/flohmaerkte.html"
>
  <main class="page-shell">
    <article class="rich-content prose page-content">
      <section class="activity-header">
        <h1>Flohmarkt</h1>
        <p>Flohmarktaktionen zur Finanzierung der Tierschutzarbeit.</p>
      </section>
      <div class="content-prose">
        <p>
          Wir bieten gespendete Waren und Waren aus Nachl&auml;ssen an. Sie sind
          f&uuml;r unseren Verein eine unabdingbare Einnahmequelle.
        </p>
        <p>
          Von den Einnahmen werden ausschlie&szlig;lich die hohen Aufwendungen
          f&uuml;r Versorgung und tier&auml;rztliche Betreuung herrenloser und
          in Not geratener Katzen bestritten. Mitgliedsbeitr&auml;ge und Spenden
          reichen hierzu bei weitem nicht aus. Unterst&uuml;tzung aus
          &ouml;ffentlicher Hand erhalten wir nicht!
        </p>
        <p>
          Entsprechende Waren werden von Jutta und Volkmar Framenau
          entgegengenommen. Beide betreiben mit gro&szlig;er Hingabe die
          Betreuung des jeweiligen Flohmarktstandes.
        </p>
        <p>
          <strong>Information</strong>
        </p>
        <p>
          Der Verein f&uuml;hrt regelm&auml;&szlig;ig Flohm&auml;rkte in der
          Innenstadt durch, unter anderem beim{' '}
          <strong>"Ku(h)riosum" am Kronenplatz in Bietigheim-Bissingen</strong>{' '}
          (<a href="/pages/termine.html">siehe Termine</a>).
        </p>
        <p>
          <picture>
            <Img
              alt="Bild aus dem Vereinsarchiv"
              fetchpriority="high"
              loading="eager"
              src="/assets/media/resources/flohmarkt-seitenmotiv-1.jpg"
            />
          </picture>
        </p>
        <p>
          <picture>
            <Img
              alt="Bild aus dem Vereinsarchiv"
              loading="lazy"
              src="/assets/media/resources/flohmarkt-seitenmotiv-2.jpg"
            />
          </picture>
        </p>
        <p>
          <picture>
            <Img
              alt="Bild aus dem Vereinsarchiv"
              loading="lazy"
              src="/assets/media/resources/kontakt-flohmarkt-seitenmotiv.jpg"
            />
          </picture>
        </p>
      </div>
    </article>
  </main>
</KatzenfreundeLayout>
