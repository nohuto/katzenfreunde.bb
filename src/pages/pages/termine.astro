---
import Img from '../../components/ui/Img.astro';
import KatzenfreundeLayout from '../../layouts/KatzenfreundeLayout.astro';
import { webpImage } from '../../utils/images';

const flyer = await webpImage('/assets/media/resources/flohmarkt2026.jpg');
const adventFlyer = await webpImage(
  '/assets/media/resources/adventsbasar-flohmarkt-2026.webp',
);
---

<KatzenfreundeLayout
  title="Termine - Katzenfreunde BiBi"
  description="Anstehende Aktionen, Veranstaltungen und Treffpunkte."
  page="termine"
  canonical="/pages/termine.html"
>
  <main>
    <section class="hero">
      <div class="hero__card hero__card--title-only">
        <div>
          <h1>Termine</h1>
        </div>
      </div>
    </section>
    <div class="page-shell">
      <article class="rich-content prose page-content">
        <section class="donation-highlight">
          <div>
            <p>
              Alle aktuellen Flohmarkt- und Aktionstermine finden Sie hier
              gesammelt. Bei kurzfristigen &Auml;nderungen{' '}
              <a href="/pages/kontakt.html">kontaktieren Sie uns</a> bitte
              direkt.
            </p>
          </div>
        </section>
        <section class="schedule-section section-divider">
          <h2>Flohmarkttermine 2026</h2>
          <p>
            Der Erl&ouml;s des Flohmarkts kommt ausschlie&szlig;lich dem
            Tierschutz zugute. Mitgliedsbeitr&auml;ge und Spenden allein reichen
            f&uuml;r die medizinische Versorgung unserer Pfleglinge nicht aus.
          </p>
          <p>
            Wir freuen uns &uuml;ber Ihren Besuch am Stand und &uuml;ber jede
            Unterst&uuml;tzung durch Eink&auml;ufe oder eine Mitgliedschaft.
          </p>
          <figure class="termine-flyer">
            <a
              class="termine-flyer__link"
              href={flyer.src}
              rel="noopener noreferrer"
              target="_blank"
            >
              <Img
                alt="Flohmarkt-Flyer 2026 der Katzenfreunde Bietigheim-Bissingen"
                fetchpriority="high"
                loading="eager"
                sizes="(max-width: 700px) 300px, 420px"
                src="/assets/media/resources/flohmarkt2026.jpg"
              />
            </a>
          </figure>
        </section>
        <section class="schedule-section section-divider">
          <h2>Adventsbasar trifft Flohmarkt</h2>
          <p>
            <strong>
              <time datetime="2026-11-28">Samstag, 28. November 2026</time>,
              9:30–15:30 Uhr
            </strong>
          </p>
          <p>
            Besen am Backhäusle, Enge Gasse 1, 71706 Unterriexingen
            (Markgröningen-Unterriexingen).
          </p>
          <p>
            Mit Adventsgestecken, Plätzchen, Flohmarktartikeln, Wurst, Punsch
            und mehr. Veranstalter sind die Katzenfreunde Bietigheim-Bissingen
            e.V., der Erlös kommt dem Verein zugute.
          </p>
          <figure class="termine-flyer">
            <a
              class="termine-flyer__link"
              href={adventFlyer.src}
              rel="noopener noreferrer"
              target="_blank"
            >
              <Img
                alt="Flyer: Adventsbasar trifft Flohmarkt am 28. November 2026 in Unterriexingen"
                loading="lazy"
                sizes="(max-width: 700px) 300px, 420px"
                src="/assets/media/resources/adventsbasar-flohmarkt-2026.webp"
              />
            </a>
          </figure>
        </section>
      </article>
    </div>
  </main>
</KatzenfreundeLayout>
