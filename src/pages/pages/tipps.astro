          <a class="pdf-preview pdf-inline-card" data-pdf="/assets/media/data/Katze_und_Urlaub.pdf" data-title="Katze und Urlaub" href="/assets/media/data/Katze_und_Urlaub.pdf" target="_blank"><span aria-hidden="true" class="pdf-inline-card__frame"><span class="pdf-placeholder">PDF Vorschau</span></span> <span class="pdf-inline-card__caption">Katze und Urlaub.pdf <span class="pdf-badge">Vorschau</span></span></a>
        </div>
        </section>
      </div>
    </article>
