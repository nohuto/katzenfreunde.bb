---
import KatzenfreundeLayout from '../../layouts/KatzenfreundeLayout.astro';
---

<KatzenfreundeLayout title="Futter Shop - Katzenfreunde BiBi" description="Bei Einkäufen über den Futter-Shop können Sie den Verein indirekt unterstützen." page="futter-shop" canonical="/pages/futter-shop.html" preload="/assets/media/resources/futter-shuttle-plakat.jpg">
<main class="page-shell">
    <article class="rich-content prose page-content">
  <section class="hero">
        <div class="hero__card hero__card--top">
          <div>
            <h1>Futter Shop</h1>
            <p>Bei Eink&auml;ufen &uuml;ber den Futter-Shop k&ouml;nnen Sie den Verein indirekt unterst&uuml;tzen.</p>
            <div class="cta-group">
              <a class="btn" href="https://www.futter-shuttle.de" rel="noopener noreferrer" target="_blank">Zum Futter-Shop</a>
              <a class="btn btn--soft" href="/pages/spenden.html">Weitere Spendenm&ouml;glichkeiten</a>
            </div>
          </div>
          <div class="hero__media">
            <picture><img alt="Bildmotiv zur Seite Futter Shop" decoding="async" fetchpriority="high" height="250" loading="eager" sizes="(max-width: 980px) 100vw, 960px" src="/assets/media/resources/futter-shuttle-plakat.jpg" width="250" />
            </picture>
          </div>
        </div>
      </section>
    </article>
</main>
</KatzenfreundeLayout>
