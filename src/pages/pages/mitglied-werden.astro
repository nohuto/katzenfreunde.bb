---
import Site from '../../layouts/Site.astro';
import Photo from '../../components/site/Photo.astro';
import Icon from '../../components/ui/Icon.astro';
import { contact, membershipRates } from '../../data/site';
---

<Site
  title="Mitglied werden"
  description="Mitglied bei den Katzenfreunden Bietigheim-Bissingen werden: Formulare, Ablauf und Beitrag."
  page="mitglied"
  path="/pages/mitglied-werden.html"
>
  <div class="page-head wrap">
    <h1>Mitglied werden</h1>
    <p class="lead lead--wide">
      Mit einer Mitgliedschaft unterstützen Sie den Verein dauerhaft.
    </p>
  </div>
  <section class="section section--tint" aria-labelledby="t-so">
    <div class="wrap split">
      <div>
        <h2 id="t-so">So werden Sie Mitglied</h2>
        <ol class="steps">
          <li>
            <h3>Antrag herunterladen</h3>
            <p>
              Den Aufnahmeantrag finden Sie hier auf der Seite. Für die
              Lastschrift enthält er bereits das SEPA-Lastschriftmandat.
            </p>
          </li>
          <li>
            <h3>Ausfüllen und abschicken</h3>
            <p>
              Schicken Sie den Antrag ausgefüllt an Katzenfreunde
              Bietigheim-Bissingen e.&nbsp;V., {contact.street}, {contact.city}.
            </p>
          </li>
          <li>
            <h3>Bestätigung erhalten</h3>
            <p>
              Nach dem Beschluss des Vorstands bestätigen wir Ihnen die
              Mitgliedschaft.
            </p>
          </li>
        </ol>
      </div>
      <div>
        <ul class="docs">
          <li>
            <a href="/assets/media/data/Aufnahmeantrag.pdf">
              <Icon name="file-pdf" />
              <span>
                <b>Aufnahmeantrag</b>
                <small>PDF, 91&nbsp;kB - für neue Mitglieder</small>
              </span>
            </a>
          </li>
          <li>
            <a href="/assets/media/data/Hoenig/SEPA.pdf">
              <Icon name="file-pdf" />
              <span>
                <b>Informationen zur SEPA-Umstellung</b>
                <small>PDF, 61&nbsp;kB</small>
              </span>
            </a>
          </li>
        </ul>
        <h3 class="h-small member__fee">Beitrag</h3>
        <p>
          {membershipRates} Mitgliedsbeiträge und Spenden sind steuerlich
          absetzbar.
        </p>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="t-warum">
    <div class="wrap split">
      <div class="prose">
        <h2 id="t-warum">Warum Mitglied in einem Tierschutzverein?</h2>
        <p>
          Sie können den Tierschutz auch ohne aktive Mitarbeit unterstützen.
          Aktive Mitarbeit ist willkommen, aber keine Voraussetzung für die
          Mitgliedschaft.
        </p>
        <blockquote class="pull">
          <p>
            „Grenzenloses Mitleid mit allen lebenden Wesen ist der festeste und
            sicherste Bürge für das sittliche Wohlverhalten.“
          </p>
          <footer>Arthur Schopenhauer</footer>
        </blockquote>
        <p>
          Im Verein lässt sich Hilfe gemeinsam organisieren. Ein Verein braucht
          viele Mitglieder, damit er seine Aufgaben langfristig erfüllen kann
          und in der Öffentlichkeit gehört wird.
        </p>
        <p>
          Haben Sie Fragen? Dann rufen Sie uns an:{' '}
          <a class="num" href={contact.tel}>
            {contact.phone}
          </a>
        </p>
      </div>
      <figure class="captioned">
        <Photo
          name="futterstelle"
          widths={[600]}
          sizes="(max-width: 47.99rem) 100vw, 30rem"
          alt="Miri, eine getigerte Streunerkätzin, im Gestrüpp"
          tag="div"
        />
        <figcaption>
          Miri, eine Streunerkätzin, wartet nahe ihrer Futterstelle.
        </figcaption>
      </figure>
    </div>
  </section>
</Site>
