---
import Site from '../layouts/Site.astro';
import Icon from '../components/ui/Icon.astro';
import { routes } from '../data/site';
---

<Site
  title="Seite nicht gefunden"
  description="Die angeforderte Seite wurde nicht gefunden."
  page={null}
  path="/404.html"
  noindex
>
  <div class="page-head wrap">
    <h1>Seite nicht gefunden</h1>
    <p class="lead">
      Unter dieser Adresse gibt es keine Seite. Vielleicht hilft Ihnen einer
      dieser Links weiter.
    </p>
    <div class="btn-row">
      <a class="go" href={routes.start}>
        <span>Zur Startseite</span>
        <Icon name="arrow-right" />
      </a>
      <a class="go" href={routes.vermittlung}>
        <span>Katzen suchen ein Zuhause</span>
        <Icon name="arrow-right" />
      </a>
      <a class="go" href={routes.kontakt}>
        <span>Kontakt</span>
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</Site>
