---
import { getImage } from 'astro:assets';
import { photo } from '../../data/photos';
import Icon from '../ui/Icon.astro';

interface Props {
  name: string;
  widths: number[];
  sizes?: string;
  alt?: string;
  class?: string;
  eager?: boolean;
  tag?: 'figure' | 'div';
  zoom?: boolean;
}

const {
  name,
  widths,
  sizes = '100vw',
  alt = '',
  class: className,
  eager = false,
  tag: Tag = 'figure',
  zoom = false,
} = Astro.props;
const src = photo(name);
const top = Math.max(...widths);
const height = Math.round((src.height / src.width) * top);
const [avif, webp] = await Promise.all(
  (['avif', 'webp'] as const).map((format) =>
    getImage({
      src,
      widths,
      sizes,
      format,
      quality: format === 'avif' ? 58 : 82,
    }),
  ),
);
const fallback = await getImage({
  src,
  width: top,
  format: 'webp',
  quality: 82,
});
const full = zoom
  ? await getImage({
      src,
      width: Math.min(src.width, 2048),
      format: 'webp',
      quality: 82,
    })
  : null;
---

<Tag class:list={['photo', className]}>
  <picture>
    <source type="image/avif" srcset={avif!.srcSet.attribute} sizes={sizes} />
    <img
      src={fallback.src}
      srcset={webp!.srcSet.attribute}
      sizes={sizes}
      width={top}
      height={height}
      alt={alt}
      loading={eager ? undefined : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  </picture>
  {full && (
    <a
      class="zoom"
      href={full.src}
      data-zoom={alt}
      aria-label="Foto vergrößern"
    >
      <Icon name="arrows-out" />
    </a>
  )}
</Tag>
